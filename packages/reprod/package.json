{
  "name": "@therecord/reprod",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reprod \u00e2\u20ac\u201d proves a running TEE machine is the source code it claims to be.",
  "scripts": {
    "scan": "tsx src/scan.ts",
    "render": "tsx src/render.ts",
    "build": "pnpm run scan && pnpm run render",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "provenance": "tsx src/provenance-cli.ts",
    "drift": "tsx src/drift-check.ts"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0"
  }
}
