{
  "name": "@therecord/design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm -w run render:all",
    "test": "vitest run",
